{
	"name": "@enekos/osagai",
	"version": "0.1.0",
	"description": "A small, dependency-free component kit for Svelte 5: buttons, fields, menus, dialogs, toasts, tables and an imperative confirm, themed by CSS variables with light and dark built in.",
	"license": "MIT",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles/theme.css": "./dist/styles/theme.css",
		"./styles/base.css": "./dist/styles/base.css"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"prepublishOnly": "npm run test && npm run build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"jsdom": "^30.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.0"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"ui",
		"design-system",
		"brutalist",
		"dark-mode"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/enekos/osagai"
	}
}
